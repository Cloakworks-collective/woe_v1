# Secures /api/tick (Vercel Cron sends it as a Bearer token). When set, the
# in-game dev time controls (+1 turn / +1 day) are disabled.
CRON_SECRET=

# Supabase (production persistence + auth + realtime — not yet wired; the
# dev file store at data/world.json is used until these exist).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — the Royal Charter (premium; spec/premium.md). With test keys,
# Stripe Checkout accepts the standard test cards (4242 4242 4242 4242).
# With NO keys, /premium shows a built-in test terminal emulating the same
# cards — zero-setup dev. STRIPE_WEBHOOK_SECRET enables the production
# webhook grant path; dev relies on success-redirect verification instead.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Opens the hidden /admin console (ban, grants, forced turns, premium).
# Unset = the console is disabled entirely.
ADMIN_PASSWORD=

# The single-writer World Service (todo.md §14.2; worldService/README.md).
# Set WORLD_SERVICE_URL on the Next.js app to forward every command to the
# always-on world service and read the world from it (instead of the in-process
# store). WORLD_SERVICE_SECRET must match the value the service runs with.
# Leave both blank to keep the in-process store (§14.1 compare-and-swap).
WORLD_SERVICE_URL=
WORLD_SERVICE_SECRET=
